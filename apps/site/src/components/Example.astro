---
/**
 * Live plain-HTML example: a sandboxed iframe loading the real @ramsarjal-404/css
 * artifacts (tokens.css + lepidus.css + lepidus.js), a 3-theme switcher, and
 * tabbed HTML / React code with copy buttons.
 *
 * Snippets live in src/snippets/<component>/<name>.html (+ optional .jsx for
 * the React rendition): <Example snippet="button/primary" />
 */
import { Code } from 'astro:components';
import { STORYBOOK_BASE } from '../lib/data';

interface Props {
  snippet: string;
  title?: string;
  /** preview iframe height; defaults to auto-fitting the content */
  height?: number;
  /** storybook story id for the "Open in Storybook" link */
  story?: string;
  /** hide the live preview (code-only example) */
  codeOnly?: boolean;
}
const { snippet, title = 'Example', height, story, codeOnly = false } = Astro.props;

const htmlFiles = import.meta.glob<string>('/src/snippets/**/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const jsxFiles = import.meta.glob<string>('/src/snippets/**/*.jsx', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const html = htmlFiles[`/src/snippets/${snippet}.html`]?.trim();
const jsx = jsxFiles[`/src/snippets/${snippet}.jsx`]?.trim();
if (!html && !jsx) {
  throw new Error(`Example: no snippet found at src/snippets/${snippet}.{html,jsx}`);
}

const srcdoc =
  html &&
  `<!doctype html>
<html data-theme="light">
<head>
<meta charset="utf-8">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap">
<link rel="stylesheet" href="/lepidus/tokens.css">
<link rel="stylesheet" href="/lepidus/lepidus.css">
<style>
  html { font-family: var(--font-family-primary, 'Open Sans', sans-serif); }
  body { margin: 0; padding: 20px; background: var(--color-background-page);
         transition: none !important; }
</style>
</head>
<body>
${html}
<script src="/lepidus/lepidus.js" defer><\/script>
</body>
</html>`;

const tabs = [
  html && { key: 'html', label: 'HTML + lp- classes', code: html, lang: 'html' as const },
  jsx && { key: 'jsx', label: 'React', code: jsx, lang: 'jsx' as const },
].filter(Boolean) as { key: string; label: string; code: string; lang: 'html' | 'jsx' }[];

const uid = `ex-${snippet.replace(/[^a-z0-9]+/gi, '-')}`;
---

<figure
  class="example"
  data-live-example
  data-snippet={html ? JSON.stringify(html) : undefined}
  data-snippet-jsx={jsx ? JSON.stringify(jsx) : undefined}
  data-snippet-name={snippet.replace(/\//g, '-')}
  style="margin-inline:0"
>
  <div class="example__bar">
    {srcdoc && !codeOnly && (
      <span class="live-pill" title="Rendered live from @ramsarjal-404/css — hover, focus and keyboard all work">
        <span class="live-pill__dot" aria-hidden="true"></span>Live
      </span>
    )}
    <span class="example__title">{title}</span>
    {srcdoc && !codeOnly && (
      <div class="theme-switch" role="group" aria-label="Example theme">
        <button type="button" aria-pressed="true" data-theme="light">Light</button>
        <button type="button" aria-pressed="false" data-theme="dark">Dark</button>
        <button type="button" aria-pressed="false" data-theme="hc">High contrast</button>
      </div>
    )}
    {(html || jsx) && (
      <button
        type="button"
        class="example__download"
        data-download
        title={html
          ? 'Download a ready-to-open .html file — double-click it to see this in your browser. No setup, nothing to install.'
          : 'Download the React component code as a .jsx file.'}
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
        Download
      </button>
    )}
    {story && (
      <span class="example__links">
        <a href={`${STORYBOOK_BASE}/?path=/story/${story}`} target="_blank" rel="noopener">
          Open in Storybook ↗
        </a>
      </span>
    )}
  </div>

  {srcdoc && !codeOnly && (
    <iframe
      class="example__frame"
      srcdoc={srcdoc}
      height={height ?? 120}
      data-auto-height={height ? undefined : ''}
      loading="lazy"
      title={`${title} — live preview`}></iframe>
  )}

  <div class="code-tabs">
    <div class="code-tabs__bar" role="tablist" aria-label="Code language">
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`${uid}-tab-${t.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`${uid}-panel-${t.key}`}
          data-code-tab={t.key}
        >
          {t.label}
        </button>
      ))}
      <button type="button" class="code-tabs__copy" data-copy>Copy</button>
    </div>
    {tabs.map((t, i) => (
      <div
        class="code-tabs__panel"
        role="tabpanel"
        id={`${uid}-panel-${t.key}`}
        aria-labelledby={`${uid}-tab-${t.key}`}
        hidden={i !== 0}
      >
        <Code code={t.code} lang={t.lang} theme="github-dark" />
      </div>
    ))}
  </div>
</figure>

<script>
  // ----- "Download" — build a self-contained, ready-to-open HTML file -------
  // For non-coders: one click produces a complete .html with all CSS and the
  // behavior script inlined, so the saved file works on its own — double-click
  // it and it opens in the browser, fully styled, no setup or other files.
  let lpCss: string | null = null;
  let lpJs: string | null = null;
  async function lepidusAssets() {
    if (lpCss === null) lpCss = await fetch('/lepidus/lepidus.css').then((r) => r.text()).catch(() => '');
    if (lpJs === null) lpJs = await fetch('/lepidus/lepidus.js').then((r) => r.text()).catch(() => '');
    return { css: lpCss, js: lpJs };
  }
  function triggerDownload(content: string, filename: string, type: string) {
    const url = URL.createObjectURL(new Blob([content], { type }));
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }
  async function downloadExample(fig: HTMLElement, btn: HTMLButtonElement) {
    const markup = JSON.parse(fig.dataset.snippet || '""');
    const jsxCode = JSON.parse(fig.dataset.snippetJsx || '""');
    const name = fig.dataset.snippetName || 'example';
    const original = btn.querySelector('svg')?.outerHTML ?? '';
    const done = () => {
      btn.innerHTML = original + ' Downloaded ✓';
      setTimeout(() => (btn.innerHTML = original + ' Download'), 1800);
    };

    // React-only example (no plain HTML) — download the component code as .jsx
    if (!markup && jsxCode) {
      triggerDownload(jsxCode, `Lepidus-${name}.jsx`, 'text/jsx');
      done();
      return;
    }

    // plain-HTML example — build a self-contained, ready-to-open .html file
    btn.textContent = 'Preparing…';
    const { css, js } = await lepidusAssets();
    const doc =
      '<!doctype html>\n<html lang="en" data-theme="light">\n<head>\n' +
      '<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n' +
      `<title>Lepidus example — ${name}</title>\n` +
      '<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap">\n' +
      '<style>\n' + css + '\n' +
      "body{font-family:var(--font-family-primary,'Open Sans',sans-serif);background:var(--color-background-page);color:var(--color-text-primary);padding:32px;margin:0}\n" +
      '</style>\n</head>\n<body>\n' +
      markup + '\n' +
      '<' + 'script>\n' + js + '\n<' + '/script>\n' +
      '</body>\n</html>\n';
    triggerDownload(doc, `lepidus-${name}.html`, 'text/html');
    done();
  }

  // ----- theme switching for srcdoc previews (same-origin, direct DOM) -----
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const dlBtn = target.closest<HTMLButtonElement>('[data-live-example] [data-download]');
    if (dlBtn) {
      downloadExample(dlBtn.closest('[data-live-example]') as HTMLElement, dlBtn);
      return;
    }

    const themeBtn = target.closest<HTMLButtonElement>('[data-live-example] .theme-switch button');
    if (themeBtn) {
      const fig = themeBtn.closest('[data-live-example]')!;
      const iframe = fig.querySelector('iframe');
      fig
        .querySelectorAll('.theme-switch button')
        .forEach((b) => b.setAttribute('aria-pressed', String(b === themeBtn)));
      iframe?.contentDocument?.documentElement.setAttribute('data-theme', themeBtn.dataset.theme!);
      return;
    }

    const tabBtn = target.closest<HTMLButtonElement>('[data-live-example] [data-code-tab]');
    if (tabBtn) {
      const fig = tabBtn.closest('[data-live-example]')!;
      fig.querySelectorAll('[data-code-tab]').forEach((b) => {
        const selected = b === tabBtn;
        b.setAttribute('aria-selected', String(selected));
        const panel = fig.querySelector(`#${b.getAttribute('aria-controls')}`);
        if (panel) (panel as HTMLElement).hidden = !selected;
      });
      return;
    }

    const copyBtn = target.closest<HTMLButtonElement>('[data-live-example] [data-copy]');
    if (copyBtn) {
      const fig = copyBtn.closest('[data-live-example]')!;
      const visible = fig.querySelector('.code-tabs__panel:not([hidden]) pre');
      if (visible) {
        navigator.clipboard.writeText(visible.textContent ?? '').then(() => {
          copyBtn.textContent = 'Copied ✓';
          setTimeout(() => (copyBtn.textContent = 'Copy'), 1400);
        });
      }
    }
  });

  // ----- auto-fit preview height to content -----
  const fit = (iframe: HTMLIFrameElement) => {
    const h = iframe.contentDocument?.body?.scrollHeight;
    if (h) iframe.height = String(Math.min(Math.max(h + 8, 64), 720));
  };
  document.querySelectorAll<HTMLIFrameElement>('[data-live-example] iframe[data-auto-height]').forEach((f) => {
    const onLoad = () => {
      fit(f);
      // fonts/late layout
      setTimeout(() => fit(f), 350);
    };
    f.addEventListener('load', onLoad);
    // A srcdoc iframe above the fold can finish loading before this script
    // runs — its load event is already gone, so fit it now.
    if (f.contentDocument?.readyState === 'complete' && f.contentDocument.body?.children.length) onLoad();
  });
</script>
