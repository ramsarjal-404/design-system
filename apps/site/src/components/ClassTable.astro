---
/**
 * lp-* class reference — generated from the manifest's plainCss inventory
 * (itself generated by packages/css/build-css.mjs from the React CSS module).
 * Classes are typed by BEM shape: block / element (`__`) / modifier (`--`).
 */
import type { PlainCss } from '../lib/data';

interface Props {
  plainCss: PlainCss;
}
const { plainCss } = Astro.props;

const rows = plainCss.classes.map((cls) => {
  const isElement = cls.includes('__') && !cls.split('__').pop()!.includes('--');
  const isModifier = cls.includes('--');
  const kind = cls === plainCss.block ? 'Block (root)' : isModifier ? 'Modifier' : isElement ? 'Element' : 'Element';
  const appliesTo = isModifier ? cls.split('--')[0] : isElement ? plainCss.block : '—';
  return { cls, kind, appliesTo };
});
const order = { 'Block (root)': 0, Element: 1, Modifier: 2 } as Record<string, number>;
rows.sort((a, b) => order[a.kind] - order[b.kind] || a.cls.localeCompare(b.cls));
---

<table class="doc-table">
  <thead>
    <tr>
      <th>Selector</th>
      <th>Kind</th>
      <th>Applies to</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((r) => (
      <tr>
        <td><code>.{r.cls}</code></td>
        <td>{r.kind}</td>
        <td>{r.appliesTo === '—' ? '—' : <code>.{r.appliesTo}</code>}</td>
      </tr>
    ))}
  </tbody>
</table>
