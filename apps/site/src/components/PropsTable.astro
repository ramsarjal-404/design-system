---
/** React props reference — generated from component-manifest.json (docgen). */
import type { PropDoc } from '../lib/data';

interface Props {
  props: PropDoc[];
}
const { props } = Astro.props;
const fmt = (v: unknown) => (v === null || v === undefined ? '—' : String(v));
---

{props.length === 0 ? (
  <p>This component takes no documented props beyond standard DOM attributes.</p>
) : (
  <table class="doc-table">
    <thead>
      <tr>
        <th>Prop</th>
        <th>Type</th>
        <th>Default</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {props.map((p) => (
        <tr>
          <td>
            <code>{p.name}</code>
            {p.required && <span class="req-pill">required</span>}
          </td>
          <td><code>{p.type}</code></td>
          <td>{fmt(p.defaultValue) === '—' ? '—' : <code>{fmt(p.defaultValue)}</code>}</td>
          <td>{p.description ?? ''}</td>
        </tr>
      ))}
    </tbody>
  </table>
)}
