---
const path = Astro.url.pathname;
const nav = [
  { href: '/get-started/', label: 'Get Started' },
  { href: '/foundations/', label: 'Foundations' },
  { href: '/components/', label: 'Components' },
  { href: '/patterns/', label: 'Patterns' },
  { href: '/tokens/', label: 'Tokens' },
  { href: '/ai/', label: 'AI' },
];
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <a class="site-header__logo" href="/">
    <span class="site-header__mark" aria-hidden="true">L</span>
    Lepidus
  </a>
  <nav class="site-header__nav" aria-label="Primary">
    {nav.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'true' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
  <span class="site-header__spacer"></span>
  <a class="site-header__search" href="/search/">
    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
    Search docs…
  </a>
  <a class="site-header__sb" href="/storybook/" target="_blank" rel="noopener">
    Storybook
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
  </a>
  <button type="button" class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode" title="Toggle dark mode">
    <svg class="t-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <svg class="t-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5.6 5.6 4.2 4.2M19.8 19.8l-1.4-1.4M5.6 18.4 4.2 19.8M19.8 4.2l-1.4 1.4"/></svg>
  </button>
</header>
