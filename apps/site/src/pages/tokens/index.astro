---
/**
 * Token reference — generated from the built tokens.css on every build.
 *
 * Anatomy per row: token name + copy button, a plain-English description
 * (curated $description from the DTCG sources when present, derived from the
 * naming grammar otherwise), and per-theme value chips with resolved colors.
 * A sticky toolbar keeps search + section navigation available while
 * scrolling 500+ tokens.
 */
import Page from '../../layouts/Page.astro';
import { loadTokens, isColor, type Token } from '../../lib/tokens';

const tokens = loadTokens();

// resolve var() chains so swatches show real colors per theme
const light = new Map(tokens.map((t) => [t.name, t.light]));
const darkM = new Map(tokens.map((t) => [t.name, t.dark ?? t.light]));
const hcM = new Map(tokens.map((t) => [t.name, t.hc ?? t.light]));
function resolve(value: string | undefined, map: Map<string, string>, depth = 0): string {
  if (!value || depth > 10) return value ?? '';
  const m = value.match(/^var\((--[\w-]+)(?:,\s*([^)]+))?\)$/);
  if (!m) return value;
  return resolve(map.get(m[1]) ?? m[2] ?? '', map, depth + 1);
}

const GROUPS = [
  'Color (semantic)',
  'Component',
  'Spacing',
  'Radius',
  'Typography',
  'Shadow',
  'Motion',
  'Z-index',
  'Breakpoints',
  'Primitives',
];
const grouped = GROUPS.map((g) => ({ group: g, tokens: tokens.filter((t) => t.group === g) })).filter(
  (g) => g.tokens.length > 0
);
const anchor = (g: string) => g.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const themed = (t: Token) => Boolean(t.dark || t.hc);
---

<Page
  title="Design tokens"
  eyebrow="Reference"
  lede={`All ${tokens.length} CSS variables generated from the Figma DTCG sources — primitive → semantic → component, themed via data-theme. Use these instead of raw values and the three themes work for free.`}
  wide
>
  <div class="token-toolbar">
    <input
      type="search"
      class="token-filter"
      placeholder={`Filter ${tokens.length} tokens by name or value…`}
      aria-label="Filter tokens"
      id="token-filter"
    />
    <nav class="token-pills" aria-label="Token groups">
      {grouped.map((g) => (
        <a href={`#${anchor(g.group)}`}>{g.group} <span>{g.tokens.length}</span></a>
      ))}
    </nav>
  </div>
  <p class="token-empty" id="token-empty" hidden>No tokens match — try part of a name (<code>button-primary</code>) or a value (<code>#1c4599</code>, <code>20px</code>).</p>

  {grouped.map((g) => (
    <section data-token-group>
      <h2 id={anchor(g.group)}>{g.group} <small class="token-count">({g.tokens.length})</small></h2>
      <table class="doc-table token-table">
        <thead>
          <tr>
            <th>Token</th>
            <th>Light</th>
            <th>Dark</th>
            <th>High contrast</th>
          </tr>
        </thead>
        <tbody>
          {g.tokens.map((t) => {
            const lv = resolve(t.light, light);
            const dv = resolve(t.dark ?? t.light, darkM);
            const hv = resolve(t.hc ?? t.light, hcM);
            const color = isColor(lv) || isColor(t.light);
            return (
              <tr
                data-token-row
                data-haystack={`${t.name} ${t.light} ${lv} ${t.description}`.toLowerCase()}
              >
                <td class="token-cell">
                  <span class="token-id">
                    <code class="token-name" tabindex="0" title="Click to copy">var({t.name})</code>
                    <button type="button" class="token-copy" data-token={t.name} aria-label={`Copy var(${t.name})`}>
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
                    </button>
                  </span>
                  {t.description && <small class="token-desc">{t.description}</small>}
                </td>
                <td>
                  <span class="value-chip">
                    {color && <span class="swatch" style={`background:${lv}`}></span>}
                    <code>{t.light}</code>
                  </span>
                  {t.light !== lv && <small class="token-resolved">{lv}</small>}
                </td>
                <td>
                  {themed(t) ? (
                    <>
                      <span class="value-chip">
                        {color && <span class="swatch" style={`background:${dv}`}></span>}
                        <code>{t.dark ?? '—'}</code>
                      </span>
                      {t.dark && t.dark !== dv && <small class="token-resolved">{dv}</small>}
                    </>
                  ) : (
                    <span class="token-same">same</span>
                  )}
                </td>
                <td>
                  {themed(t) ? (
                    <>
                      <span class="value-chip">
                        {color && <span class="swatch" style={`background:${hv}`}></span>}
                        <code>{t.hc ?? '—'}</code>
                      </span>
                      {t.hc && t.hc !== hv && <small class="token-resolved">{hv}</small>}
                    </>
                  ) : (
                    <span class="token-same">same</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>
  ))}

  <script>
    // copy — via the icon button or by clicking the token name
    const copyToken = (name: string, feedbackEl: HTMLElement) => {
      navigator.clipboard.writeText(`var(${name})`).then(() => {
        feedbackEl.classList.add('is-copied');
        setTimeout(() => feedbackEl.classList.remove('is-copied'), 1100);
      });
    };
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest<HTMLButtonElement>('.token-copy');
      if (btn) {
        copyToken(btn.dataset.token!, btn.closest('.token-id')!);
        return;
      }
      const name = target.closest<HTMLElement>('.token-name');
      if (name) {
        copyToken(name.textContent!.replace(/^var\(|\)$/g, ''), name.closest('.token-id')!);
      }
    });

    // live filter with empty state
    const input = document.getElementById('token-filter') as HTMLInputElement;
    const empty = document.getElementById('token-empty')!;
    input?.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let any = false;
      document.querySelectorAll<HTMLElement>('[data-token-row]').forEach((row) => {
        const show = !q || row.dataset.haystack!.includes(q);
        row.style.display = show ? '' : 'none';
        if (show) any = true;
      });
      document.querySelectorAll<HTMLElement>('[data-token-group]').forEach((sec) => {
        const has = sec.querySelector('[data-token-row]:not([style*="none"])');
        sec.style.display = has ? '' : 'none';
      });
      empty.hidden = any;
    });
  </script>
</Page>
