---
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import { categories, components } from '../../lib/data';

const clean = (d: string) => d.replace(/ — Lepidus Design System\.?$/, '');
---

<Base title="Components" description="All Lepidus components — usage, code, specifications, and accessibility.">
  <div class="site-shell">
    <Sidebar />
    <main class="site-main" data-pagefind-body>
      <p class="page-eyebrow">Library</p>
      <h1>Components</h1>
      <p class="page-lede">
        {components.length} accessible, token-driven components. Every one ships as plain
        HTML/CSS (<code>@ramsarjal-404/css</code>) where marked, and as React (<code>@ramsarjal-404/react</code>).
        Each page covers Usage, Code, Specifications, and Accessibility.
      </p>
      {categories.map((group) => (
        <>
          <h2>{group.name}</h2>
          <ul class="comp-grid">
            {group.components.map((c) => (
              <li>
                <a class="comp-card" href={`/components/${c.slug}/`}>
                  {c.meta.heroStory && (
                    <div class="comp-card__thumb">
                      <img src={`/thumbs/${c.slug}.png`} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="comp-card__body">
                    <p class="tile__title">{c.name}</p>
                    <p class="tile__desc">{c.meta.description ?? clean(c.description)}</p>
                    <span class="tile__meta">
                      {c.plainCss ? 'HTML + CSS · React' : 'React'}
                    </span>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </>
      ))}
    </main>
  </div>
</Base>
