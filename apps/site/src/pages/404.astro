---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <main class="site-main" style="max-width: 720px; margin: 0 auto; text-align: center; min-height: 50vh">
    <h1>404 — page not found</h1>
    <p class="page-lede" style="margin: 16px auto">
      Looking for a component? Try the <a href="/components/">component index</a> or{' '}
      <a href="/search/">search</a>. Old Storybook links now live under{' '}
      <a href="/storybook/">/storybook/</a>.
    </p>
  </main>
</Base>
