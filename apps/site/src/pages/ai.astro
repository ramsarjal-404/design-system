---
import { Code } from 'astro:components';
import Page from '../layouts/Page.astro';
import Callout from '../components/Callout.astro';

const SITE = 'https://lepidus-design-system-button.vercel.app';

const chatContext = `I'm building UI with the Lepidus Design System.

Before generating any UI, read and follow the rules and component list here:
${SITE}/llms.txt

Output plain HTML using the documented lp- classes only — never hardcoded
colors — and set data-theme="light" | "dark" | "hc" on <html> for theming.
Link ${SITE}/v1/lepidus.css in <head> and ${SITE}/v1/lepidus.js (defer)
before </body> so the page runs as-is.

Now build what I describe next.`;

const plainPrompt = `Build a settings page: a "Server name" text box, three radio
options (hourly / daily / weekly), and a red "Delete server" button that opens
a confirmation popup. Make it work in dark mode too.`;

const rulesBlock = `# UI rules — Lepidus Design System

This project uses Lepidus (${SITE}).

- Build UI with the documented lp- classes only. The complete inventory:
  ${SITE}/llms.txt
- Never hardcode colors, spacing, radii, or font sizes. Use
  var(--component-*) first, then var(--color-*) / var(--space-*) /
  var(--radius-*). Hardcoded hex values fail review.
- Theming: set data-theme="light" | "dark" | "hc" on <html>.
  Never write per-theme values by hand.
- Interactive components use lepidus.js: data-lp-tabs, data-lp-modal-open /
  data-lp-modal-close, data-lp-accordion, data-lp-dropdown="single|multi",
  data-lp-stepper, data-lp-tooltip, or Lepidus.toast({...}) /
  Lepidus.openModal(id). Copy the exact markup from
  ${SITE}/llms-full.txt — never invent nesting.
- Keep the documented accessibility markup: role="switch" + aria-checked on
  toggles, aria-invalid + aria-describedby on input errors, aria-current in
  breadcrumbs, aria-label on listboxes, role="img" + aria-label on avatars.`;

const mcpConfig = `{
  "mcpServers": {
    "lepidus": {
      "command": "node",
      "args": ["../lepidus-design-system/packages/mcp/server.mjs"]
    }
  }
}`;

const validateCmd = `# from a checkout of the design-system repo
node scripts/validate-lp-html.mjs path/to/screen.html   # ✓ or FAIL lines; exit 1 on failure`;

const reviewGrep = `# any hex color outside a var() fallback is a violation
grep -rnE '#[0-9a-fA-F]{3,8}\\b' src/ --include='*.html' --include='*.css' --include='*.tsx' \\
  | grep -vE 'var\\(--[a-z0-9-]+,\\s*#'   # var(--token, #fallback) is allowed`;

// Editor tabs — only the filename/location differs; the rules are identical.
const tools = [
  { key: 'claude', name: 'Claude Code', file: 'CLAUDE.md', dl: 'CLAUDE.md', loc: 'repo root', mcp: '.mcp.json' },
  { key: 'cursor', name: 'Cursor', file: '.cursorrules', dl: '.cursorrules', loc: 'repo root, or .cursor/rules/*.mdc', mcp: '.cursor/mcp.json' },
  { key: 'copilot', name: 'GitHub Copilot', file: '.github/copilot-instructions.md', dl: 'copilot-instructions.md', loc: 'in .github/', mcp: '.vscode/mcp.json' },
  { key: 'codex', name: 'OpenAI Codex', file: 'AGENTS.md', dl: 'AGENTS.md', loc: 'repo root', mcp: '~/.codex/config.toml' },
  { key: 'windsurf', name: 'Windsurf', file: '.windsurfrules', dl: '.windsurfrules', loc: 'repo root', mcp: 'mcp_config.json' },
];
---

<Page
  title="AI-assisted development"
  eyebrow="For AI assistants & their humans"
  lede="Make any AI tool fluent in Lepidus — so 'build the alerts page' comes back with real lp- classes, live tokens, and the accessibility intact. Pick the lane that fits how you work."
>
  <Callout variant="success" title="Everything on this page is tested">
    <p>The MCP tools, the <a href="/llms.txt">llms.txt</a> rules, and the
    <a href="/component-manifest.json">component manifest</a> are exercised by this repo's own
    build — and the generated markup patterns pass axe (WCAG 2.1 AA) in CI across all three
    themes. If it's documented here, it runs.</p>
  </Callout>

  <ul class="path-grid" aria-label="Choose your lane">
    <li>
      <a class="path-card" href="#chat">
        <span class="path-card__icon" style="background:#f0ebfa" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#6d5bd0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </span>
        <span>
          <strong>I describe what I want in a chat</strong>
          <small>ChatGPT, Claude, Gemini, v0, Lovable — no setup</small>
        </span>
      </a>
    </li>
    <li>
      <a class="path-card" href="#editor">
        <span class="path-card__icon" style="background:#e9f0ff" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#1c4599" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5M16 7l5 5-5 5"/></svg>
        </span>
        <span>
          <strong>I code in an editor with AI</strong>
          <small>VS Code, Cursor, Claude Code, Codex, Windsurf</small>
        </span>
      </a>
    </li>
    <li>
      <a class="path-card" href="/design.md" download="lepidus-design.md">
        <span class="path-card__icon" style="background:#e6f6ec" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="#1caa52" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
        </span>
        <span>
          <strong>I want the whole system in one file</strong>
          <small>Download design.md — every component, snippet, prop and token</small>
        </span>
      </a>
    </li>
  </ul>

  <h2 class="step" id="chat"><span class="step__num" aria-hidden="true">A</span>Describe it in a chat</h2>
  <p>
    For ChatGPT, Claude.ai, Gemini, or AI page-builders like v0 and Lovable — no files, nothing
    to install. Three steps.
  </p>

  <h3>1 · Paste this once, at the start of your chat</h3>
  <p>
    It points the assistant at <a href="/llms.txt"><code>llms.txt</code></a> — the rules and every legal
    class name, ~2k tokens. For anything beyond a single screen, paste
    <a href="/llms-full.txt"><code>llms-full.txt</code></a> instead (or as well): the same rules plus
    every documented HTML example verbatim, ~25k tokens — fits any current model, and the assistant
    copies real nesting instead of guessing it.
  </p>
  <div class="copy-wrap">
    <button type="button" class="copy-btn" data-copy-pre>Copy</button>
    <Code code={chatContext} lang="text" theme="github-dark" />
  </div>

  <h3>2 · Describe your screen in plain words</h3>
  <div class="copy-wrap">
    <button type="button" class="copy-btn" data-copy-pre>Copy</button>
    <Code code={plainPrompt} lang="text" theme="github-dark" />
  </div>

  <h3>3 · Use what it gives you</h3>
  <p>
    The assistant replies with HTML. To see it running, open any
    <a href="/components/">component's Code tab</a> and use the
    <strong>Download</strong> button on an example as your starting file — or paste the HTML into
    a free online editor like CodePen. Either way it renders fully styled, with no setup.
  </p>
  <Callout variant="info" title="The honest limit">
    <p>Chat tools are great for a screen or a prototype. For a real product codebase, the editor
    lane below keeps every future prompt on-system automatically.</p>
  </Callout>

  <h2 class="step" id="editor"><span class="step__num" aria-hidden="true">B</span>Set up your editor</h2>
  <p>
    Teach your assistant once; every prompt after that returns on-system Lepidus code. Pick your
    tool — only the filename changes:
  </p>

  <div class="tool-tabs" role="tablist" aria-label="Editor">
    {tools.map((t, i) => (
      <button
        type="button"
        role="tab"
        data-tool={t.key}
        data-file={t.file}
        data-dl={t.dl}
        data-loc={t.loc}
        data-mcp={t.mcp}
        aria-selected={i === 0 ? 'true' : 'false'}
      >
        {t.name}
      </button>
    ))}
  </div>

  <h3>1 · Create the rules file</h3>
  <p>
    Create <code data-tool-file>CLAUDE.md</code> <span data-tool-loc>(repo root)</span> and paste
    the block below — or click <strong>Download</strong> and drop the ready-made file into your
    project. Assistants read it automatically and stop inventing class names.
  </p>
  <div class="copy-wrap" id="rules-wrap">
    <button type="button" class="copy-btn" data-copy-pre>Copy</button>
    <button type="button" class="copy-btn copy-btn--dl" data-download-rules>Download <span data-tool-dl>CLAUDE.md</span></button>
    <Code code={rulesBlock} lang="markdown" theme="github-dark" />
  </div>

  <h3>2 · Add live lookup with MCP <small style="font-weight:400;color:var(--site-ink-faint)">— optional, recommended</small></h3>
  <p>
    The rules tell the assistant <em>how to behave</em>; the MCP server lets it <em>look facts up
    mid-task</em> — exact props, the legal classes for a component, token values per theme. Add
    this to <code data-tool-mcp>.mcp.json</code> in your project:
  </p>
  <div class="copy-wrap">
    <button type="button" class="copy-btn" data-copy-pre>Copy</button>
    <Code code={mcpConfig} lang="json" theme="github-dark" />
  </div>
  <table class="doc-table">
    <thead><tr><th>Tool</th><th>Ask it for</th></tr></thead>
    <tbody>
      <tr><td><code>list_components</code></td><td>Every component, with plain-CSS availability</td></tr>
      <tr><td><code>get_component</code></td><td>Props, lp- classes, and the import for one component</td></tr>
      <tr><td><code>search_tokens</code></td><td>Token variables by name <em>or value</em> ("#1c4599" works), per theme</td></tr>
      <tr><td><code>get_usage_rules</code></td><td>The full llms.txt contract</td></tr>
    </tbody>
  </table>
  <Callout variant="info" title="MCP is the power-user upgrade">
    <p>It needs a checkout of the design-system repo, so it's a developer convenience. The
    <a href="/llms.txt">llms.txt</a> URL works in <em>every</em> tool with zero setup — start
    there, add MCP when you want live lookups.</p>
  </Callout>

  <h2>Prompt it, then verify</h2>
  <p>To confirm setup actually took, paste a question with a verifiable answer:</p>
  <ul>
    <li>
      <em>"What classes does the Tag component have?"</em> — expect the exact inventory
      (<code>lp-tag</code>, status modifiers, <code>lp-tag__label</code>,
      <code>lp-tag__remove</code>). Invented classes mean the rules file isn't loaded.
    </li>
    <li>
      <em>"Which token is the brand blue, and what is it in dark theme?"</em> — expect
      <code>--color-brand-primary</code> → <code>var(--blue-600)</code> light,
      <code>var(--blue-400)</code> dark.
    </li>
  </ul>

  <h2>Review it like any other PR</h2>
  <p>AI output earns the same review as a teammate's. Three fast checks:</p>
  <ul>
    <li><strong>No raw hex values</strong> — one grep finds every violation:</li>
  </ul>
  <div class="copy-wrap">
    <button type="button" class="copy-btn" data-copy-pre>Copy</button>
    <Code code={reviewGrep} lang="bash" theme="github-dark" />
  </div>
  <ul>
    <li><strong>Run the validator</strong> — the repo ships <code>scripts/validate-lp-html.mjs</code>:
      classes against the manifest, hooks against <code>lepidus.js</code>, raw hex, the Modal /
      Dropdown / Tabs / Table / Toggle / Input-error anatomy, and the page shell. One command, exit 1
      on any failure:</li>
  </ul>
  <div class="copy-wrap">
    <button type="button" class="copy-btn" data-copy-pre>Copy</button>
    <Code code={validateCmd} lang="bash" theme="github-dark" />
  </div>
  <ul>
    <li><strong>Only documented classes</strong> — every <code>lp-*</code> class appears on the
      component's <a href="/components/">Specifications tab</a> (the complete legal set).</li>
    <li><strong>Accessibility and theming survived</strong> — tab through it (focus rings, the
      modal traps focus), then set <code>data-theme="dark"</code>; anything that breaks was
      hardcoded.</li>
  </ul>

  <h2 id="design-md">The whole system in one file — the AI Design Contract</h2>
  <p>
    <a href="/design.md"><code>/design.md</code></a> is a single Markdown file that makes an assistant
    produce the <em>documented</em> Lepidus implementation, not a lookalike. For every one of the 44
    components it carries the legal class set, the hooks and ARIA the canonical markup relies on,
    every HTML and React example verbatim, the React API, the accessibility contract and a hard-fail
    checklist — plus the rules, source precedence, page archetypes, the generation workflow and output
    format, review gates, two complete validated screens, and all tokens per theme. It is generated on
    every build from the same sources as this site, so it never drifts from the docs.
  </p>
  <ul>
    <li><strong>For people</strong> — download it and keep the system offline, or search one file
      instead of forty pages.</li>
    <li><strong>For assistants</strong> — it is ~160k tokens, so it belongs in a <em>knowledge base</em>,
      not a chat message: upload it to a Claude Project, a custom GPT, or NotebookLM once and every
      conversation can look things up. In an editor, keep it in the repo and <code>@</code>-mention it.
      For a single chat, use <a href="/llms-full.txt"><code>llms-full.txt</code></a> (~25k tokens) instead.</li>
  </ul>
  <p style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
    <a class="btn btn--primary" href="/design.md" download="lepidus-design.md">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14"/></svg>
      Download design.md
    </a>
    <a class="btn btn--secondary" href="/design.md" target="_blank" rel="noopener">View in browser ↗</a>
    <span style="color:var(--site-ink-faint);font-size:13px">Markdown · ~630 KB · regenerated on every build</span>
  </p>

  <h2>Under the hood</h2>
  <p>
    Five layers power all of this: <a href="/llms.txt"><code>/llms.txt</code></a> (the
    plain-language contract + class inventory), <a href="/llms-full.txt"><code>/llms-full.txt</code></a>
    (the contract + every HTML example, one paste), <a href="/design.md"><code>/design.md</code></a>
    (the full reference in one file), <a href="/component-manifest.json"><code>/component-manifest.json</code></a>
    (every prop and class in machine-readable form, regenerated on every build — the
    Specifications tabs on this site are this file, visualized), and the MCP server
    (<code>packages/mcp/server.mjs</code> — design doc in <code>packages/mcp/README.md</code>).
  </p>
</Page>

<script>
  // ---- copy any code block via its sibling button ----
  function copyFrom(btn: HTMLElement) {
    const pre = btn.closest('.copy-wrap')?.querySelector('pre');
    if (!pre) return;
    navigator.clipboard
      .writeText(pre.textContent ?? '')
      .then(() => flash(btn, 'Copied ✓'))
      .catch(() => {
        const range = document.createRange();
        range.selectNodeContents(pre);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        flash(btn, 'Press ⌘C');
      });
  }
  function flash(btn: HTMLElement, msg: string) {
    const html = btn.innerHTML;
    btn.textContent = msg;
    setTimeout(() => (btn.innerHTML = html), 1600);
  }

  // ---- editor tool picker: swap the filenames, not the rules ----
  const ruleFiles = document.querySelectorAll<HTMLElement>('[data-tool-file]');
  const ruleLocs = document.querySelectorAll<HTMLElement>('[data-tool-loc]');
  const ruleDls = document.querySelectorAll<HTMLElement>('[data-tool-dl]');
  const ruleMcps = document.querySelectorAll<HTMLElement>('[data-tool-mcp]');
  let currentDl = 'CLAUDE.md';
  function selectTool(tab: HTMLElement) {
    document.querySelectorAll<HTMLElement>('.tool-tabs [data-tool]').forEach((b) => {
      const on = b === tab;
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
    });
    const file = tab.dataset.file!;
    currentDl = tab.dataset.dl!;
    ruleFiles.forEach((el) => (el.textContent = file));
    ruleLocs.forEach((el) => (el.textContent = `(${tab.dataset.loc})`));
    ruleDls.forEach((el) => (el.textContent = currentDl));
    ruleMcps.forEach((el) => (el.textContent = tab.dataset.mcp!));
  }

  // roving tabindex: only the selected tab is in the Tab order; arrows move
  const toolTabs = Array.from(document.querySelectorAll<HTMLElement>('.tool-tabs [data-tool]'));
  toolTabs.forEach((b, i) => (b.tabIndex = i === 0 ? 0 : -1));
  document.querySelector('.tool-tabs')?.addEventListener('keydown', (e) => {
    const i = toolTabs.indexOf(document.activeElement as HTMLElement);
    if (i === -1) return;
    const next =
      e.key === 'ArrowRight' ? (i + 1) % toolTabs.length
      : e.key === 'ArrowLeft' ? (i - 1 + toolTabs.length) % toolTabs.length
      : e.key === 'Home' ? 0
      : e.key === 'End' ? toolTabs.length - 1
      : -1;
    if (next === -1) return;
    e.preventDefault();
    toolTabs[next].focus();
    selectTool(toolTabs[next]);
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const tab = target.closest<HTMLElement>('.tool-tabs [data-tool]');
    if (tab) {
      selectTool(tab);
      return;
    }

    const dl = target.closest<HTMLElement>('[data-download-rules]');
    if (dl) {
      const pre = document.querySelector('#rules-wrap pre');
      const text = pre?.textContent ?? '';
      const url = URL.createObjectURL(new Blob([text], { type: 'text/markdown' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = currentDl;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      flash(dl, 'Downloaded ✓');
      return;
    }

    const copy = target.closest<HTMLElement>('[data-copy-pre]');
    if (copy) copyFrom(copy);
  });
</script>
