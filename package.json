    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@storybook/test": "^8.6.18",
    "@storybook/test-runner": "^0.19.1",
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.0",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.5.0"
  }
}